{
  "random_seed": 42,
  "paths": {
    "project_root": ".",
    "baseline_las": "pointclouds/substation_baseline.las",
    "origin_las": "pointclouds/substation_origin.las",
    "device_search_dirs": ["pointclouds", "."],
    "device_recursive": false,
    "output_dir": "outputs"
  },
  "io": {
    "chunk_size": 800000
  },
  "progress": {
    "log_every_chunks": 8
  }, 
  "preprocess": {
    "rotation_sample_max_points": 250000,
    "ground_sample_max_points": 250000,
    "ground_quantile": 0.03,
    "obstacle_z_margin": 0.2,
    "preprocess_z_margin": 0.1,
    "voxel_size": 0.5
  },
  "flight_volume": {
    "h_min": 2.0,
    "h_top": 2.0
  },
  "grid": {
    "voxel_size": 0.3
  },
  "safety": {
    "d0": 2.0,
    "sigma_gps": 1.0,
    "k_gps": 1.0,
    "d_ctrl": 0.2,
    "r_uav": 0.35,
    "sigma_model": 0.15,
    "wire_min_height_from_ground": 4.0,
    "unsegmented_type": "wires"
  },
  "risk_coefficients": {
    "transformer": 1.2,
    "wires": 1.15,
    "shelf": 0.95,
    "tube": 0.9,
    "capacitor": 0.85,
    "building": 0.65,
    "gantry": 0.95,
    "bus_related": 0.95,
    "tower": 0.85,
    "structure": 0.8,
    "default": 0.9
  },
  "device_type_keywords": {
    "transformer": ["main_transformer", "transformer"],
    "shelf": ["shelf", "gantry", "frame"],
    "tube": ["tube", "gis_tube", "gis"],
    "wires": ["wire", "wires", "line", "conductor"],
    "capacitor": ["capacitor"],
    "building": ["building", "room", "house", "control"],
    "gantry": ["gantry", "bus"],
    "tower": ["tower", "pole"],
    "structure": ["frame", "structure"]
  },
  "type_priority": {
    "wires": 120,
    "transformer": 100,
    "shelf": 80,
    "tube": 70,
    "capacitor": 65,
    "building": 40,
    "gantry": 60,
    "default": 10
  },
  "inspectable_device_types": ["transformer", "shelf", "tube", "wires", "capacitor"],
  "visualization": {
    "max_plot_points": 180000,
    "overlay_cloud_max_points": 120000,
    "overlay_nofly_max_points": 120000,
    "overlay_free_max_points": 100000,
    "mission_altitude_agl": 2.5,
    "free_slice_half_thickness": 0.45,
    "mid_altitude_agl": 10.0,
    "mid_slice_half_thickness": 0.75,
    "device_type_plot_max_points": 50000,
    "device_type_bbox_max": 120,
    "type_colors": {
      "transformer": "#ff3b30",
      "wires": "#ff9500",
      "shelf": "#34c759",
      "tube": "#00c7be",
      "capacitor": "#007aff",
      "building": "#8e8e93",
      "default": "#9b59b6"
    },
    "legend_display_names": {
      "transformer": "main transformer",
      "building": "buildings",
      "tube": "GIS tube"
    },
    "gif_frames": 72,
    "gif_fps": 12,
    "gif_elev": 22.0,
    "gif_name": "cloud_nofly_rotate.gif",
    "compare_gif_name": "cloud_nofly_free_compare_rotate.gif",
    "types_gif_name": "device_types_rotate.gif",
    "free_bands_gif_name": "cloud_free_bands_rotate.gif",
    "free_scan_stride": 1,
    "free_scan_fps": 12,
    "free_scan_gif_name": "free_space_layer_scan.gif",
    "free_scan_iso_max_points": 70000,
    "free_scan_iso_elev": 22.0,
    "free_scan_iso_azim": 25.0,
    "free_scan_iso_fps": 12,
    "free_scan_iso_gif_name": "free_space_layer_scan_iso.gif"
  },
  "sweep_analysis": {
    "enabled": true,
    "output_subdir": "sweep_maps",
    "export_npz": true,
    "metric_low_altitude_agl": 2.5,
    "metric_mid_altitude_agl": 10.0,
    "dynamic_cases": [
      { "name": "dynamic_d0_1.8", "d0": 1.8, "k_gps": 1.0, "d_ctrl": 0.2 },
      { "name": "dynamic_d0_2.0", "d0": 2.0, "k_gps": 1.0, "d_ctrl": 0.2 },
      { "name": "dynamic_d0_2.3", "d0": 2.3, "k_gps": 1.0, "d_ctrl": 0.2 },
      { "name": "dynamic_d0_2.6", "d0": 2.6, "k_gps": 1.1, "d_ctrl": 0.25 }
    ],
    "static_d_eff_values": [3.3, 3.8, 4.3],
    "plot_name": "sweep_free_space_compare.png",
    "summary_name": "sweep_summary.json",
    "csv_name": "sweep_summary.csv"
  }
}
