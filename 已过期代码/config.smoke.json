    "preprocess_z_margin": 0.1,
    "voxel_size": 0.8
  },
  "flight_volume": {
    "h_min": 2.0,
    "h_top": 1.5
  },
  "grid": {
    "voxel_size": 0.6
  },
  "safety": {
    "d0": 3.0,
    "sigma_gps": 1.0,
    "k_gps": 1.2,
    "d_ctrl": 0.3,
    "r_uav": 0.35,
    "sigma_model": 0.15,
    "wire_min_height_from_ground": 4.0,
    "unsegmented_type": "gantry"
  },
  "risk_coefficients": {
    "transformer": 1.0,
    "gantry": 1.0,
    "bus_related": 1.0,
    "capacitor": 0.9,
    "tower": 0.8,
    "structure": 0.8,
    "default": 1.0
  },
  "device_type_keywords": {
    "transformer": ["transformer", "main_transformer"],
    "capacitor": ["capacitor"],
    "gantry": ["gantry", "bus", "shelf"],
    "tower": ["tower", "pole"],
    "structure": ["frame", "structure"]
  },
  "visualization": {
    "max_plot_points": 50000,
    "overlay_cloud_max_points": 50000,
    "overlay_nofly_max_points": 50000,
    "overlay_free_max_points": 40000,
    "gif_frames": 48,
    "gif_fps": 10,
    "gif_elev": 22.0,
    "gif_name": "cloud_nofly_rotate_smoke.gif",
    "compare_gif_name": "cloud_nofly_free_compare_rotate_smoke.gif"
  }
