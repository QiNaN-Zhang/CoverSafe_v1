{
  "random_seed": 7,
  "paths": {
    "project_root": "simplified",
    "baseline_las": "简化版模型/substation.las",
    "origin_las": "简化版模型/substation_origin_not_used.las",
    "device_search_dirs": ["简化版模型", "."],
    "device_recursive": false,
    "output_dir": "outputs_smoke"
  },
  "io": {
    "chunk_size": 300000
  },
  "progress": {
