{
  "random_seed": 42,
  "paths": {
    "project_root": ".",
    "phase2_reference_config": "phases/phase2_single_device/configs/config.phase2.single_device.json",
    "station_grid_npz": "outputs/phase1_feasible_space/station_grid_map.npz",
    "phase1_report_json": "outputs/phase1_feasible_space/feasible_space_report.json",
    "output_dir": "outputs/phase4_baselines"
  },
  "scenarios": {
    "constrained_projected": {
      "enable": true,
      "apply_phase1_constraints": true,
      "constraint_handling": "project",
      "project_max_radius_steps": 24
    },
    "unconstrained_native": {
      "enable": true,
      "apply_phase1_constraints": false,
      "constraint_handling": "none",
      "project_max_radius_steps": 24
    }
  },
  "methods": {
    "fc_planner_lite": {
      "enable": true,
      "generator": "fc_planner_lite",
      "standoff_scale": 1.0,
      "reorder_strategy": "global_tsp",
      "fc_params": {
        "max_surface_points": 5000,
        "num_levels": 6,
        "azimuth_bins": 12,
        "z_band_m": 0.6,
        "max_viewpoints": 180,
        "min_viewpoint_spacing_m": 0.8
      }
    },
    "predrecon_lite": {
      "enable": true,
      "generator": "predrecon_lite",
      "standoff_scale": 1.0,
      "reorder_strategy": "none",
      "pred_params": {
        "max_surface_points": 2400,
        "max_candidates": 140,
        "max_viewpoints": 120,
        "min_new_visible_points": 20,
        "target_uncovered_ratio": 0.06,
        "min_viewpoint_spacing_m": 0.8
      }
    }
  },
  "device_name_whitelist": [
    "main_transformer"
  ],
  "max_devices": 1
}
